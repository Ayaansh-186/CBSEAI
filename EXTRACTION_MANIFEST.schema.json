{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBSE official corpus extraction manifest",
  "type": "object",
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "doc_type",
          "official_url",
          "content_sha256",
          "syllabus_year",
          "language",
          "page_count",
          "raw_pdf"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "doc_type": {
            "enum": ["ncert", "exemplar", "sqp", "ms", "model", "cfpq", "pyqp"]
          },
          "official_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://([a-z0-9-]+\\.)*(ncert\\.nic\\.in|epathshala\\.nic\\.in|cbseacademic\\.nic\\.in)/"
          },
          "content_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "syllabus_year": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "ncert_edition": { "type": ["string", "null"] },
          "language": { "enum": ["en", "hi"] },
          "page_count": { "type": "integer", "minimum": 1 },
          "raw_pdf": { "type": "string", "minLength": 1 },
          "page_images_dir": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
