# ─── Model ────────────────────────────────────────────────────────────────
# "mock"    → canned streaming replies, no network. Use this while fine-tuning.
# "openai"  → any OpenAI-compatible /v1/chat/completions endpoint.
#             Works with vLLM, SGLang, Nebius, Together, Fireworks, Ollama.
MODEL_PROVIDER=mock

# Qwen2.5-VL-7B AWQ through vLLM's OpenAI-compatible API
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=
MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# Keep theory text-only. Image turns use this Qwen VL checkpoint.
VISION_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ

# ─── Retrieval ────────────────────────────────────────────────────────────
# "memory" → ships with seed chunks so the UI renders citations today.
# "qdrant" → production vector store path, implemented in lib/rag/vectorstore.ts
RAG_PROVIDER=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cbse_10_2026
QDRANT_AUTO_CREATE=true
QDRANT_VECTOR_SIZE=1024
HYBRID_SEARCH=true

# Embeddings for the corpus. Any OpenAI-compatible /v1/embeddings endpoint.
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# Optional BGE-M3 lexical-weight endpoint. When blank, deterministic local
# lexical weights are used for sparse Qdrant search.
SPARSE_EMBEDDINGS_BASE_URL=
SPARSE_EMBEDDINGS_API_KEY=
SPARSE_EMBEDDINGS_MODEL=BAAI/bge-m3

# OpenAI/Jina-style rerank endpoint: {query, documents, top_n}.
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# FAQ cache. memory works locally; redis uses an Upstash-compatible REST API.
CACHE_PROVIDER=memory
CACHE_TTL_SECONDS=3600
REDIS_REST_URL=
REDIS_REST_TOKEN=

# Optional MNLI service. POST receives {model, premise, hypotheses} and returns
# results with {label, score}. Leave blank for structural verification only.
NLI_BASE_URL=
NLI_API_KEY=
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_THRESHOLD=0.72

# Required for POST /api/ingest.
INGEST_API_KEY=replace-with-a-long-random-secret

# Extracted diagram crops are data/diagrams/<chunk_id>.webp by default.
DIAGRAM_DIR=data/diagrams
DIAGRAM_SIGNING_SECRET=replace-with-a-different-long-random-secret
DIAGRAM_URL_TTL_SECONDS=900

# Academic year the corpus is pinned to. NCERT changes every year — the
# retriever hard-filters on this so last year's text never leaks into answers.
NCERT_YEAR=2026-27
